# Conversation engine configuration.
# Copy to .env and fill in. .env is gitignored.

PORT=3000

# --- Amazon Bedrock ---------------------------------------------------------
# Credentials are never picked up implicitly. Set exactly ONE of the three
# sources below, or the engine refuses to make a call. This is deliberate: the
# AWS provider chain falls back to ~/.aws/credentials, which silently runs as
# whatever profile is on the machine and bills that account.

# 1. A named profile -- the normal local-development answer.
#    Create it with: aws configure sso
#    Refresh it with: aws sso login --profile poise-engine
AWS_PROFILE=poise-engine

# 2. Explicit keys, if not using a profile.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=            # only for temporary/STS credentials

# 3. The provider chain, deliberately. Set this ONLY where credentials come
#    from an instance or task role and there are no env vars to read.
# AWS_USE_AMBIENT_CREDENTIALS=true

# The account this service is allowed to bill. Checked once against STS before
# the first model call; a mismatch refuses to run rather than spending on the
# wrong account. Strongly recommended on any machine with more than one set of
# AWS credentials.
AWS_EXPECTED_ACCOUNT_ID=488179516477

# Model availability and model access are both per-region, so set this
# explicitly in deployment rather than relying on the profile's default.
AWS_REGION=us-west-2

# Defaults to us.anthropic.claude-haiku-4-5-20251001-v1:0 (cheapest tier; each
# engine stage is a short single-shot call). The "us." prefix is a cross-region
# inference profile, which newer Claude models require -- a bare model id is
# rejected as not supported for on-demand throughput.
# BEDROCK_MODEL_ID=

# --- Engine authentication ---------------------------------------------------
# Shared key the app sends in X-Poise-App-Key. Compiled into the iOS binary,
# so treat it as public: it filters random internet traffic, it is not the
# security boundary. Generate: openssl rand -hex 32
POISE_APP_KEY=

# Signs conversation tokens (issued on turn 1, required for later turns and
# feedback). Server-only, never in the app. Rotating it invalidates every
# in-flight conversation. Generate: openssl rand -hex 32
POISE_TOKEN_SECRET=

# --- Energy ledger -----------------------------------------------------------
# SQLite file holding per-user energy. Single-instance only; move to a shared
# store before running more than one server. Gitignored.
# ENGINE_DB_PATH=./engine.db

# --- Pro entitlement ---------------------------------------------------------
# RevenueCat SECRET key (sk_...), used to verify Pro server-side. Leave unset
# and every user is free tier. Never ship this in the app.
# REVENUECAT_SECRET_KEY=

# --- Testing -----------------------------------------------------------------
# Returns schema-shaped placeholders instead of calling the model, and never
# constructs a Bedrock or STS client. Set for any local test of the server's
# own behaviour so no request is ever billed.
# ENGINE_DRY_RUN=true
