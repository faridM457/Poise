# No API key needed — the backend calls Claude via the Claude Agent SDK,
# which shells out to your local Claude Code login (`claude login`) and uses
# your Claude Pro/Max subscription's usage instead of per-token API billing.
#
# Optional: override the model (alias 'haiku' | 'sonnet' | 'opus', or a full
# model ID). Defaults to 'haiku' to go easy on your plan's usage limits.
# CLAUDE_ENGINE_MODEL=haiku

PORT=3000
