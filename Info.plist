<dict>
	<!-- Answers App Store Connect's export-compliance question at archive time
	     instead of it resurfacing on every single upload. The app only uses
	     HTTPS/TLS (standard OS-provided transport security) -- no custom or
	     proprietary encryption -- which is exempt from export documentation. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Local-only ATS exception so the app can call the conversation-engine
	     dev server over plain HTTP on localhost. Merged with Xcode's
	     auto-generated Info.plist (GENERATE_INFOPLIST_FILE stays YES). Do not
	     widen this to NSAllowsArbitraryLoads or a non-localhost domain. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<!-- Narrow speech/mic exception: lets the user speak their turn instead of
	     typing it, via Apple's on-device Speech framework (SFSpeechRecognizer).
	     No audio is sent anywhere off-device for this. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Poise uses your microphone so you can speak your response instead of typing it.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Poise transcribes your spoken response on-device so you can review it before sending.</string>
	<!-- Poise's real AdMob app ID. There is only one Info.plist for both
	     build configurations, so Debug builds now request real ads too (no
	     Debug/Release split here, unlike AdsConfig's ad unit ID in
	     AppConfiguration.swift) -- fine for a real, already-created AdMob
	     app, just worth knowing if test-ad behavior is ever expected again. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-4763995977400393~6126839851</string>
